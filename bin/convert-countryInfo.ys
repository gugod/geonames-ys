#!/usr/bin/env ys-0

use: geonames

defn main(file="data/countryInfo.txt"):
  country-info =: load-country-info(file)
  say:
    yaml/dump: country-info

defn load-country-info(file):
  lines =:
    grep _ geonames/lines(file):
      fn(line): line.starts?("#"):not

  rows =:
    map _ lines:
      fn(line): line.split("\t")

  map _ rows:
    fn(row):
      make-country-info:
        interleave geonames/country-info-columns: row

defn make-country-info(x):
  m =: apply(omap x)
  =>: !:geonames/country-info:
    ISO                : ! m.ISO
    ISO3               : ! m.ISO3
    ISO-Numeric        : ! m.get("ISO-Numeric"):geonames/to-nil-if-zero
    fips               : ! m.get("fips"):geonames/to-nil-if-empty
    Country            : ! m.get("Country")
    Capital            : ! m.get("Capital")
    Area               : ! m.get("Area(in sq km)"):N
    Population         : ! m.get("Population"):N
    Continent          : ! m.get("Continent")
    tld                : ! m.get("tld"):geonames/to-nil-if-empty
    CurrencyCode       : ! m.get("CurrencyCode"):geonames/to-nil-if-empty
    CurrencyName       : ! m.get("CurrencyName"):geonames/to-nil-if-empty
    Phone              : ! m.get("Phone"):geonames/to-nil-if-empty
    PostalCodeFormat   : ! m.get("Postal Code Format"):geonames/to-nil-if-empty
    PostalCodeRegex    : ! m.get("Postal Code Regex"):geonames/to-nil-if-empty
    Languages          : ! m.get("Languages"):geonames/csv-list-or-nil
    geonameid          : ! m.geonameid:N
    neighbours         : ! m.get("neighbours"):geonames/csv-list-or-nil
    EquivalentFipsCode : ! m.get("EquivalentFipsCode"):geonames/to-nil-if-empty
