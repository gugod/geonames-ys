#!/usr/bin/env ys-0

use: geonames

defn main(file="data/countryInfo.txt"):
  country-info =: load-country-info(file)
  say:
    yaml/dump: country-info

defn load-country-info(file):
  lines =:
    grep _ geonames/lines(file):
      fn(line): line.starts?("#"):not

  rows =:
    map _ lines:
      fn(line): line.split("\t")

  map _ rows:
    fn(row):
      make-country-info:
        interleave geonames/country-info-columns: row

defn to-nil-if-empty(s):
  if s == "":
    then: nil
    else: s

defn to-nil-if-zero(s):
  if s == "0":
    then: nil
    else: s

defn make-country-info(x):
  m =: apply(omap x)
  =>: !:geonames/country-info:
    ISO         : ! m.ISO
    ISO3        : ! m.ISO3
    ISO-Numeric : ! m.get("ISO-Numeric"):to-nil-if-zero
    fips        : ! m.get("fips"):to-nil-if-empty
    Country     : ! m.get("Country")
    Capital     : ! m.get("Capital")
    Area        : ! m.get("Area(in sq km)"):N
    Population  : ! m.get("Population"):N
    Continent   : ! m.get("Continent")
    # tld
    CurrencyCode : ! m.get("CurrencyCode"):to-nil-if-empty
    CurrencyName : ! m.get("CurrencyName"):to-nil-if-empty
    # Phone
    # Postal Code Format
    # Postal Code Regex
    # Languages
    geonameid   : ! m.geonameid:N
    # geonameid
    # neighbours
    # EquivalentFipsCode
