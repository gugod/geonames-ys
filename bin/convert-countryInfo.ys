#!/usr/bin/env ys-0

use geonames:

defn main(file="data/countryInfo.txt"):
  country-info =: load-country-info(file)
  say:
    yaml/dump: country-info

defn load-country-info(file):
  lines =:
    grep _ slurp(file):lines:
      fn(line): line.starts?("#"):not

  rows =:
    map _ lines:
      fn(line):
        # Lines end with "\r\n" and that makes last element always being an "\r"
        line.split("\t"):drop-last

  map _ rows:
    fn(row):
      apply omap:
        interleave geonames/country-info-columns: row
