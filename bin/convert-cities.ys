#!/usr/bin/env ys-0

use geonames:

defn main(file="data/cities500.txt"):
  cities =: load-cities(file)
  say:
    yaml/dump: cities

defn load-cities(file):
  rows =:
    map _ geonames/lines(file):
      fn(line): line.split("\t")

  map _ rows:
    fn(row):
      apply omap:
        interleave geonames/columns: row
