!yamlscript/v0/code

ns: geonames

use: schemays
require schemays: => T

# Copied from readme.txt then manually re-arranged
columns =: !
  - geonameid
  - name
  - asciiname
  - alternatenames
  - latitude
  - longitude
  - feature class
  - feature code
  - country code
  - cc2
  - admin1 code
  - admin2 code
  - admin3 code
  - admin4 code
  - population
  - elevation
  - dem
  - timezone
  - modification date

# Copied from countryInfo.txt then manually re-arranged
country-info-columns =: !
  - ISO
  - ISO3
  - ISO-Numeric
  - fips
  - Country
  - Capital
  - Area(in sq km)
  - Population
  - Continent
  - tld
  - CurrencyCode
  - CurrencyName
  - Phone
  - Postal Code Format
  - Postal Code Regex
  - Languages
  - geonameid
  - neighbours
  - EquivalentFipsCode

# Utilties
# --------

defn lines(file):
  map _ std/lines(slurp(file)):
    # Lines end with "\r\n" and that makes last element always being an "\r"
    fn(line): line:chomp

defn to-nil-if-empty(s):
  if s:empty?:
    then: nil
    else: s

defn to-nil-if-zero(s):
  if s == "0":
    then: nil
    else: s

defn csv-list(s):
  if s:empty?:
    then: (list)
    else: s.split(",")

defn csv-list-or-nil(s):
  if s:empty?:
    then: nil
    else: s.split(",")

# Types
# -----

# Continenet codes in copied from readme.txt
continents =: !:T/enum:
  - AF
  - AS
  - EU
  - NA
  - OC
  - SA
  - AN

# iso2, iso3, fips are actually lengthy enum. In here we are lazy just use some regex to make a wider set.
iso2 =:
  T/get-str-rgx: "/[A-Z][A-Z]/"

iso3 =:
  T/get-str-rgx: "/[A-Z][A-Z][A-Z]/"

iso-numeric =: # String. Leading zeros.
  T/get-str-rgx: "/[0-9][0-9][0-9]/"

fips-code =:
  T/get-str-rgx: "/[A-Z][A-Z]/"

currency-codes =:
  T/get-str-rgx: "/[A-Z][A-Z][A-Z]/"

tld =:
  T/get-str-rgx: "/\\.[a-z][a-z]/"

language-code =:
  T/string-length: 1 200

city-name =:
  T/string-length: 1 200

longitude =:
  fn(val):
    val =: val:T/number
    when-not (<= -180 val 180):
      die: "Not a valid longitude: $val"
    =>: val

latitude =:
  fn(val):
    val =: val:T/number
    when-not (<= -90 val 90):
      die: "Not a valid latitude: $val"
    =>: val

feature-class =: T/string-length(1 1)

feature-code =: T/string-length(1 10)

country-code =:
  T/get-str-rgx: "/[A-Z][A-Z]/"

admin1-code =: T/string-length(1 20)

admin2-code =: T/string-length(1 80)

admin3-code =: T/string-length(1 20)

admin4-code =: T/string-length(1 20)

dem =: T/integer

timezone =: T/string-length(1 40)

yyyymmdd =:
  T/get-str-rgx: "/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/"

country-info =: !:T/map:
  "ISO"                : ! iso2
  "ISO3"               : ! iso3
  "ISO-Numeric"        : ! T/maybe(iso-numeric)
  "fips"               : ! T/maybe(fips-code)
  "Country"            : ! T/string-length(1 200)
  "geonameid"          : ! T/integer
  "Area"               : ! T/positive-num-or-zero
  "Continent"          : ! continents
  "Capital"            : ! T/string-length(0 200)
  "CurrencyCode"       : ! T/maybe(currency-codes)
  "Population"         : ! T/positive-num-or-zero
  "CurrencyName"       : ! T/maybe(T/string-length(1 20))
  "tld"                : ! T/maybe(tld)
  "Phone"              : ! T/maybe(T/string-length(1 20))
  "PostalCodeFormat"   : ! T/maybe(T/string-length(1 60))
  "PostalCodeRegex"    : ! T/maybe(T/string-length(1 200))
  "Languages"          : ! T/maybe(T/list(language-code))
  "neighbours"         : ! T/maybe(T/list(iso2))
  "EquivalentFipsCode" : ! T/maybe(fips-code)

city =: !:T/map:
  "geonameid"          : ! T/integer
  "name" : ! city-name
  "asciiname" : ! T/maybe(city-name)
  "alternatenames" : ! T/maybe(T/list(city-name))
  "latitude": ! latitude
  "longitude": ! longitude
  "featureClass": ! feature-class
  "featureCode": ! T/maybe(feature-code)
  "countryCode": ! country-code
  "cc2": ! T/maybe(T/list(country-code))
  "admin1Code": ! T/maybe(admin1-code)
  "admin2Code": ! T/maybe(admin2-code)
  "admin3Code": ! T/maybe(admin3-code)
  "admin4Code": ! T/maybe(admin4-code)
  "population": ! T/positive-num-or-zero
  "elevation": ! T/maybe(T/number)
  "dem": ! dem
  "timezone": ! timezone
  "modificationDate": ! yyyymmdd
