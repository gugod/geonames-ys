!yamlscript/v0/code

ns: geonames

use: schemays
require schemays: => T

# Copied from readme.txt then manually re-arranged
columns =: !
  - geonameid
  - name
  - asciiname
  - alternatenames
  - latitude
  - longitude
  - feature class
  - feature code
  - country code
  - cc2
  - admin1 code
  - admin2 code
  - admin3 code
  - admin4 code
  - population
  - elevation
  - dem
  - timezone
  - modification date

# Copied from countryInfo.txt then manually re-arranged
country-info-columns =: !
  - ISO
  - ISO3
  - ISO-Numeric
  - fips
  - Country
  - Capital
  - Area(in sq km)
  - Population
  - Continent
  - tld
  - CurrencyCode
  - CurrencyName
  - Phone
  - Postal Code Format
  - Postal Code Regex
  - Languages
  - geonameid
  - neighbours
  - EquivalentFipsCode

defn lines(file):
  map _ std/lines(slurp(file)):
    # Lines end with "\r\n" and that makes last element always being an "\r"
    fn(line): line:chomp

# Types
# -----

# Continenet codes in copied from readme.txt
continents =: !:T/enum:
  - AF
  - AS
  - EU
  - NA
  - OC
  - SA
  - AN

# iso2, iso3, fips are actually lengthy enum. In here we are lazy just use some regex to make a wider set.
iso2 =:
  T/get-str-rgx: "/[A-Z][A-Z]/"

iso3 =:
  T/get-str-rgx: "/[A-Z][A-Z][A-Z]/"

iso-numeric =: # String. Leading zeros.
  T/get-str-rgx: "/[0-9][0-9][0-9]/"

fips-code =:
  T/get-str-rgx: "/[A-Z][A-Z]/"

# Some fields in countryInfo.txt contain empty string or "0" as a way to say that the field is N/A for the given "country".
# Since they are not available, it makes sense to turn those invalid values to nils.

defn fips-code-or-nil(val):
  if val:nil?:
    then: val
    else:
      fips-code: val

defn iso-numeric-or-nil(val):
  if val:nil?:
    then: val
    else:
      iso-numeric: val

country-info =: !:T/map:
  "ISO"         : ! iso2
  "ISO3"        : ! iso3
  "ISO-Numeric" : ! iso-numeric-or-nil
  "fips"        : ! fips-code-or-nil
  "Country"     : ! T/string-length(1 200)
  "geonameid"   : ! T/integer
  "Area"        : ! T/positive-num-or-zero
  "Continent"   : ! continents

# "Capital" "Andorra la Vella",
# "Country" "Andorra",
# "CurrencyCode" "EUR",
# "CurrencyName" "Euro",
# "Languages" "ca",
# "Phone" "376",
# "Population" "77006",
# "Postal Code Format" "AD###",
# "Postal Code Regex" "^(?:AD)*(\\d{3})$",
# "neighbours" "ES,FR",
# "tld" ".ad"
