!yamlscript/v0/code

ns: geonames

use: schemays
require schemays: => T

# Copied from readme.txt then manually re-arranged
columns =: !
  - geonameid
  - name
  - asciiname
  - alternatenames
  - latitude
  - longitude
  - feature class
  - feature code
  - country code
  - cc2
  - admin1 code
  - admin2 code
  - admin3 code
  - admin4 code
  - population
  - elevation
  - dem
  - timezone
  - modification date

# Copied from countryInfo.txt then manually re-arranged
country-info-columns =: !
  - ISO
  - ISO3
  - ISO-Numeric
  - fips
  - Country
  - Capital
  - Area(in sq km)
  - Population
  - Continent
  - tld
  - CurrencyCode
  - CurrencyName
  - Phone
  - Postal Code Format
  - Postal Code Regex
  - Languages
  - geonameid
  - neighbours
  - EquivalentFipsCode

defn lines(file):
  map _ std/lines(slurp(file)):
    # Lines end with "\r\n" and that makes last element always being an "\r"
    fn(line): line:chomp

iso2 =:
  T/get-str-rgx: "/[A-Z][A-Z]/"

iso3 =:
  T/get-str-rgx: "/[A-Z][A-Z][A-Z]/"

country-info =: !:T/map:
  geonameid: ! T/integer
  ISO: ! iso2
  ISO3: ! iso3
  Area: ! T/positive-num
